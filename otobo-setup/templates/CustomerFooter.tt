<div id='oooFooter'>
    <div>
        <div id='oooCopyright'>
            <p class='ooo10g'>© 2026 </p>
            <a href="https://www.digitalfactory.sn" target="_blank" style="text-decoration:none;font-weight:bold;color:#0d1b4b;font-size:15px;">Résolve360 — Digital Factory SN</a>
        </div>
        <div id='FooterLinks'>
[% IF(Data.FooterLinks) %]
    [% FOREACH Link IN Data.FooterLinks %]
            <a href="[% Link.Target | html %]" target="_blank" class="ooo10g">[% Link.Description | Translate | html %]</a>
    [% END %]
[% END %]
        </div>
        <div id='ooo'>
            <p class='ooo10g'>Powered by <strong>Résolve360</strong> &mdash; <a href="https://reclam.digitalfactory.sn" target="_blank">Digital Factory SN</a></p>
        </div>
    </div>
</div>

[% InsertTemplate("CustomerFooterJS.tt") %]

</body>
</html>
